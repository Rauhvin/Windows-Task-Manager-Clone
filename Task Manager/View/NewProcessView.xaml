<Window x:Class="Task_Manager.NewProcessView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Manager"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Create new task" Height="250" Width="410" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="Run" Width="40" Height="40" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
            <TextBlock Text="Enter name program, folder or document,and it will be open by system Windows"
                       Margin="15,0,0,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="13"
                       MaxWidth="300"/>
        </StackPanel>

        <TextBox Grid.Row="1" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Open"
                 materialDesign:TextFieldAssist.HasClearButton="True"
                 VerticalAlignment="Top"
                 Margin="0,10,0,0">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding StartProcessCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TextBox.InputBindings>
        </TextBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Command="{Binding StartProcessCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Width="100" Margin="0,0,10,0"/>
        </StackPanel>
        
    </Grid>

</Window>
